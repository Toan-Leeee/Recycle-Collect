<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/surface" android:padding="20dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Loại vật liệu" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/green_dark" android:layout_marginTop="6dp"/>
  <Spinner android:layout_width="match_parent" android:layout_height="46dp" android:id="@+id/material_filter" android:background="@drawable/bg_card"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Khoảng cách tối đa: 5 km" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/ink" android:layout_marginTop="20dp"/>
  <SeekBar android:layout_width="match_parent" android:layout_height="40dp" android:id="@+id/distance_filter" android:max="10" android:progress="5"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="1 km" android:textSize="11sp" android:textStyle="normal" android:textColor="@color/ink" android:layout_marginTop="0dp" android:layout_weight="1"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10 km" android:textSize="11sp" android:textStyle="normal" android:textColor="@color/ink" android:layout_marginTop="0dp"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
    <Button android:layout_width="0dp" android:layout_height="46dp" android:id="@+id/btn_filter" android:text="Áp dụng bộ lọc" android:layout_marginTop="0dp" android:layout_weight="1"/>
    <Button android:layout_width="0dp" android:layout_height="46dp" android:id="@+id/btn_next" android:text="Xem bản đồ" android:layout_marginTop="0dp" style="@style/SecondaryButton" android:layout_weight="1"/>
  </LinearLayout>
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="15dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/explore_list" android:orientation="vertical"/>
  </ScrollView>
</LinearLayout>

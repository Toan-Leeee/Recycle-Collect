<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <ImageView android:layout_width="76dp" android:layout_height="76dp" android:src="@drawable/ic_recycle" android:contentDescription="Logo tái chế" android:layout_gravity="center_horizontal" android:layout_marginTop="18dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Họ và tên" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/green_dark" android:layout_marginTop="24dp"/>
    <EditText android:layout_width="match_parent" android:layout_height="46dp" android:id="@+id/register_name" android:hint="Nhập họ và tên" android:inputType="text" android:background="@drawable/bg_card" android:paddingStart="10dp" android:paddingEnd="10dp" android:textSize="14sp" android:textColor="@color/ink" android:layout_marginTop="5dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Email" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/green_dark" android:layout_marginTop="16dp"/>
    <EditText android:layout_width="match_parent" android:layout_height="46dp" android:id="@+id/register_email" android:hint="Nhập email" android:inputType="textEmailAddress" android:background="@drawable/bg_card" android:paddingStart="10dp" android:paddingEnd="10dp" android:textSize="14sp" android:textColor="@color/ink" android:layout_marginTop="5dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mật khẩu" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/green_dark" android:layout_marginTop="16dp"/>
    <EditText android:layout_width="match_parent" android:layout_height="46dp" android:id="@+id/register_password" android:hint="Tạo mật khẩu" android:inputType="textPassword" android:background="@drawable/bg_card" android:paddingStart="10dp" android:paddingEnd="10dp" android:textSize="14sp" android:textColor="@color/ink" android:layout_marginTop="5dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Xác nhận mật khẩu" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/green_dark" android:layout_marginTop="16dp"/>
    <EditText android:layout_width="match_parent" android:layout_height="46dp" android:id="@+id/register_confirm" android:hint="Nhập lại mật khẩu" android:inputType="textPassword" android:background="@drawable/bg_card" android:paddingStart="10dp" android:paddingEnd="10dp" android:textSize="14sp" android:textColor="@color/ink" android:layout_marginTop="5dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Vai trò" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/green_dark" android:layout_marginTop="24dp"/>
    <RadioGroup android:layout_width="match_parent" android:layout_height="48dp" android:id="@+id/register_role" android:orientation="horizontal">
      <RadioButton android:layout_width="0dp" android:layout_height="match_parent" android:id="@+id/role_resident" android:text="Người dân" android:layout_weight="1" android:checked="true" android:buttonTint="@color/ink"/>
      <RadioButton android:layout_width="0dp" android:layout_height="match_parent" android:id="@+id/role_collector" android:text="Người thu gom" android:layout_weight="1" android:buttonTint="@color/ink"/>
    </RadioGroup>
    <Button android:layout_width="match_parent" android:layout_height="46dp" android:id="@+id/btn_next" android:text="Đăng ký" android:layout_marginTop="25dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/register_login" android:text="Đã có tài khoản? Đăng nhập" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/ink" android:layout_marginTop="18dp" android:gravity="center"/>
  </LinearLayout>
</ScrollView>

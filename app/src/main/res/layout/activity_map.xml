<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/surface" android:padding="20dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/map_status" android:text="Giấy / carton · Trong phạm vi 5 km" android:textSize="12sp" android:textStyle="normal" android:textColor="@color/ink" android:layout_marginTop="5dp"/>
  <WebView android:layout_width="match_parent" android:layout_height="0dp" android:id="@+id/request_map" android:layout_weight="1" android:layout_marginTop="15dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Yêu cầu trong khu vực" android:textColor="@color/ink" android:textStyle="bold" android:textSize="13sp" android:layout_marginTop="10dp"/>
  <Button android:layout_width="match_parent" android:layout_height="46dp" android:id="@+id/btn_my_location" android:text="Vị trí của tôi" android:layout_marginTop="10dp" style="@style/SecondaryButton"/>
  <LinearLayout android:id="@+id/map_preview_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="10dp"/>
  <Button android:layout_width="match_parent" android:layout_height="46dp" android:id="@+id/btn_next" android:text="Xem danh sách yêu cầu" android:layout_marginTop="8dp" style="@style/SecondaryButton"/>
</LinearLayout>

<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="20dp">
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Vật liệu" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/ink" android:layout_marginTop="0dp" android:layout_weight="1"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đơn giá tham khảo" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/ink" android:layout_marginTop="0dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="18dp">
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Giấy / carton" android:textSize="13sp" android:textStyle="normal" android:textColor="@color/ink" android:layout_marginTop="0dp" android:layout_weight="1"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/price_paper" android:text="3.000 đ/kg" android:textSize="13sp" android:textStyle="normal" android:textColor="@color/ink" android:layout_marginTop="0dp"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" android:layout_marginTop="8dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="18dp">
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Nhựa PET" android:textSize="13sp" android:textStyle="normal" android:textColor="@color/ink" android:layout_marginTop="0dp" android:layout_weight="1"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/price_plastic" android:text="5.000 đ/kg" android:textSize="13sp" android:textStyle="normal" android:textColor="@color/ink" android:layout_marginTop="0dp"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" android:layout_marginTop="8dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="18dp">
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Kim loại" android:textSize="13sp" android:textStyle="normal" android:textColor="@color/ink" android:layout_marginTop="0dp" android:layout_weight="1"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/price_metal" android:text="10.000 đ/kg" android:textSize="13sp" android:textStyle="normal" android:textColor="@color/ink" android:layout_marginTop="0dp"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" android:layout_marginTop="8dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="18dp">
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Thủy tinh" android:textSize="13sp" android:textStyle="normal" android:textColor="@color/ink" android:layout_marginTop="0dp" android:layout_weight="1"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1.000 đ/kg" android:textSize="13sp" android:textStyle="normal" android:textColor="@color/ink" android:layout_marginTop="0dp"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" android:layout_marginTop="8dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="18dp">
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Điện tử" android:textSize="13sp" android:textStyle="normal" android:textColor="@color/ink" android:layout_marginTop="0dp" android:layout_weight="1"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15.000 đ/kg" android:textSize="13sp" android:textStyle="normal" android:textColor="@color/ink" android:layout_marginTop="0dp"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" android:layout_marginTop="8dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Đơn vị tính: đồng / kg" android:textSize="12sp" android:textStyle="normal" android:textColor="@color/ink" android:layout_marginTop="26dp"/>
    <Button android:layout_width="match_parent" android:layout_height="46dp" android:id="@+id/btn_next" android:text="Tạo yêu cầu thu gom" android:layout_marginTop="48dp" style="@style/SecondaryButton"/>
  </LinearLayout>
</ScrollView>

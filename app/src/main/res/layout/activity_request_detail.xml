<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <FrameLayout android:layout_width="match_parent" android:layout_height="180dp" android:background="@drawable/bg_card" android:layout_marginTop="10dp">
      <ImageView android:id="@+id/detail_photo" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="Ảnh vật liệu"/>
      <TextView android:id="@+id/detail_photo_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:background="@color/mint" android:padding="6dp" android:text="Ảnh minh họa · yêu cầu chưa có ảnh chụp" android:textColor="@color/ink" android:textSize="11sp"/>
    </FrameLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/detail_material" android:text="TG001 · Giấy carton" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/ink" android:layout_marginTop="18dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/detail_id" android:text="TG001" android:textSize="12sp" android:textStyle="normal" android:textColor="@color/ink" android:layout_marginTop="0dp" android:visibility="gone"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/detail_status" android:text="Trạng thái: Chờ nhận" android:textSize="13sp" android:textStyle="normal" android:textColor="@color/ink" android:layout_marginTop="15dp"/>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" android:layout_marginTop="10dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/detail_weight" android:text="Khối lượng dự kiến: 5 kg" android:textSize="13sp" android:textStyle="normal" android:textColor="@color/ink" android:layout_marginTop="10dp"/>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" android:layout_marginTop="10dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/detail_location" android:text="Địa điểm: Cầu Giấy, Hà Nội" android:textSize="13sp" android:textStyle="normal" android:textColor="@color/ink" android:layout_marginTop="10dp"/>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" android:layout_marginTop="10dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/detail_collector" android:text="Người thu gom: Chưa có" android:textSize="13sp" android:textStyle="normal" android:textColor="@color/ink" android:layout_marginTop="10dp"/>
    <Button android:layout_width="match_parent" android:layout_height="46dp" android:id="@+id/btn_next" android:text="Nhận yêu cầu" android:layout_marginTop="65dp"/>
    <Button android:layout_width="match_parent" android:layout_height="46dp" android:id="@+id/btn_chat" android:text="Tin nhắn" android:drawableStart="@drawable/ic_message" android:drawablePadding="6dp" android:layout_marginTop="8dp" android:visibility="gone" style="@style/SecondaryButton"/>
    <Button android:layout_width="match_parent" android:layout_height="46dp" android:id="@+id/btn_edit" android:text="Chỉnh sửa yêu cầu" android:layout_marginTop="8dp" style="@style/SecondaryButton"/>
    <Button android:layout_width="match_parent" android:layout_height="46dp" android:id="@+id/btn_cancel" android:text="Hủy yêu cầu" android:layout_marginTop="8dp" style="@style/SecondaryButton"/>
  </LinearLayout>
</ScrollView>

<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/result_request" android:text="TG001 · Giấy / carton" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/ink" android:layout_marginTop="18dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Khối lượng thực tế (kg)" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/green_dark" android:layout_marginTop="20dp"/>
    <EditText android:layout_width="match_parent" android:layout_height="46dp" android:id="@+id/actual_weight" android:hint="4,5" android:inputType="numberDecimal" android:background="@drawable/bg_card" android:paddingStart="10dp" android:paddingEnd="10dp" android:textSize="14sp" android:textColor="@color/ink" android:layout_marginTop="5dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Đơn giá theo bảng giá" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/green_dark" android:layout_marginTop="28dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/result_price" android:text="3.000 đ/kg" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/ink" android:layout_marginTop="12dp" android:gravity="end"/>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" android:layout_marginTop="10dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tổng tiền" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/green_dark" android:layout_marginTop="18dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/result_total" android:text="13.500 đ" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/ink" android:layout_marginTop="12dp" android:gravity="end"/>
    <TextView android:id="@+id/result_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Trạng thái: Đã nhận" android:textSize="12sp" android:textStyle="normal" android:textColor="@color/ink" android:layout_marginTop="24dp"/>
    <Button android:layout_width="match_parent" android:layout_height="46dp" android:id="@+id/btn_next" android:text="Gửi kết quả thu gom" android:layout_marginTop="45dp"/>
  </LinearLayout>
</ScrollView>

<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Loại vật liệu" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/green_dark" android:layout_marginTop="12dp"/>
    <Spinner android:layout_width="match_parent" android:layout_height="46dp" android:id="@+id/material" android:background="@drawable/bg_card" android:layout_marginTop="5dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Khối lượng dự kiến (kg)" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/green_dark" android:layout_marginTop="16dp"/>
    <EditText android:layout_width="match_parent" android:layout_height="46dp" android:id="@+id/weight" android:hint="5" android:inputType="numberDecimal" android:background="@drawable/bg_card" android:paddingStart="10dp" android:paddingEnd="10dp" android:textSize="14sp" android:textColor="@color/ink" android:layout_marginTop="5dp"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="114dp" android:background="@drawable/bg_card" android:layout_marginTop="16dp">
      <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/photo_hint" android:text="Chưa có ảnh vật liệu" android:gravity="center" android:textColor="@color/muted" android:textSize="13sp"/>
      <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/photo_preview" android:visibility="gone" android:scaleType="centerCrop" android:contentDescription="Ảnh vật liệu"/>
    </FrameLayout>
    <Button android:layout_width="match_parent" android:layout_height="46dp" android:id="@+id/btn_camera" android:text="Chụp ảnh vật liệu" android:layout_marginTop="10dp" style="@style/SecondaryButton"/>
    <Button android:layout_width="match_parent" android:layout_height="46dp" android:id="@+id/btn_gallery" android:text="Chọn ảnh từ máy" android:layout_marginTop="8dp" style="@style/SecondaryButton"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Địa điểm thu gom" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/green_dark" android:layout_marginTop="18dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="46dp" android:id="@+id/location_text" android:text="Địa chỉ từ vị trí GPS" android:gravity="center_vertical" android:background="@drawable/bg_card" android:paddingStart="10dp" android:textSize="13sp"/>
    <Button android:layout_width="match_parent" android:layout_height="46dp" android:id="@+id/btn_location" android:text="Lấy lại vị trí GPS" android:layout_marginTop="8dp" style="@style/SecondaryButton"/>
    <Button android:layout_width="match_parent" android:layout_height="46dp" android:id="@+id/btn_next" android:text="Gửi yêu cầu" android:layout_marginTop="24dp"/>
  </LinearLayout>
</ScrollView>

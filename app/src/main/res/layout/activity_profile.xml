<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/profile_heading" android:text="Nguyễn Minh Anh" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/ink" android:layout_marginTop="12dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/profile_role" android:text="Người dân" android:textSize="12sp" android:textStyle="normal" android:textColor="@color/ink" android:layout_marginTop="4dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Email" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/green_dark" android:layout_marginTop="24dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/profile_email" android:text="minhanh@example.com" android:textSize="14sp" android:textStyle="normal" android:textColor="@color/ink" android:layout_marginTop="5dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Họ và tên" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/green_dark" android:layout_marginTop="16dp"/>
    <EditText android:layout_width="match_parent" android:layout_height="46dp" android:id="@+id/profile_name" android:hint="Họ và tên" android:inputType="text" android:background="@drawable/bg_card" android:paddingStart="10dp" android:paddingEnd="10dp" android:textSize="14sp" android:textColor="@color/ink" android:layout_marginTop="5dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Số điện thoại" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/green_dark" android:layout_marginTop="16dp"/>
    <EditText android:layout_width="match_parent" android:layout_height="46dp" android:id="@+id/profile_phone" android:hint="Nhập số điện thoại" android:inputType="phone" android:background="@drawable/bg_card" android:paddingStart="10dp" android:paddingEnd="10dp" android:textSize="14sp" android:textColor="@color/ink" android:layout_marginTop="5dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Địa chỉ" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/green_dark" android:layout_marginTop="16dp"/>
    <EditText android:layout_width="match_parent" android:layout_height="46dp" android:id="@+id/profile_address" android:hint="Nhập địa chỉ liên hệ" android:inputType="textPostalAddress" android:background="@drawable/bg_card" android:paddingStart="10dp" android:paddingEnd="10dp" android:textSize="14sp" android:textColor="@color/ink" android:layout_marginTop="5dp"/>
    <Button android:layout_width="match_parent" android:layout_height="46dp" android:id="@+id/btn_next" android:text="Lưu thay đổi" android:layout_marginTop="30dp"/>
    <Button android:layout_width="match_parent" android:layout_height="46dp" android:id="@+id/btn_logout" android:text="Đăng xuất" android:layout_marginTop="8dp" style="@style/SecondaryButton"/>
  </LinearLayout>
</ScrollView>

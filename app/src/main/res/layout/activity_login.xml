<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
    <ImageView android:layout_width="76dp" android:layout_height="76dp" android:src="@drawable/ic_recycle" android:contentDescription="Logo tái chế" android:layout_gravity="center_horizontal" android:layout_marginTop="28dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="THU GOM TÁI CHẾ" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/green" android:layout_marginTop="12dp" android:gravity="center"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Đăng nhập" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/ink" android:layout_marginTop="18dp" android:gravity="center"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Email" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/green_dark" android:layout_marginTop="34dp"/>
    <EditText android:layout_width="match_parent" android:layout_height="46dp" android:id="@+id/email" android:hint="Nhập email" android:inputType="textEmailAddress" android:background="@drawable/bg_card" android:paddingStart="10dp" android:paddingEnd="10dp" android:textSize="14sp" android:textColor="@color/ink" android:layout_marginTop="5dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mật khẩu" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/green_dark" android:layout_marginTop="16dp"/>
    <EditText android:layout_width="match_parent" android:layout_height="46dp" android:id="@+id/password" android:hint="Nhập mật khẩu" android:inputType="textPassword" android:background="@drawable/bg_card" android:paddingStart="10dp" android:paddingEnd="10dp" android:textSize="14sp" android:textColor="@color/ink" android:layout_marginTop="5dp"/>
    <Button android:layout_width="match_parent" android:layout_height="46dp" android:id="@+id/btn_login" android:text="Đăng nhập" android:layout_marginTop="28dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btn_register" android:text="Chưa có tài khoản? Đăng ký ngay" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/ink" android:layout_marginTop="18dp" android:gravity="center"/>
  </LinearLayout>
</ScrollView>

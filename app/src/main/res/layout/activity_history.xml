<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tổng khối lượng đã thu gom" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/green_dark" android:layout_marginTop="14dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/history_weight" android:text="45 kg" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/ink" android:layout_marginTop="8dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tổng tiền giao dịch hoàn tất" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/green_dark" android:layout_marginTop="25dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/history_total" android:text="210.000 đ" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/ink" android:layout_marginTop="8dp"/>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" android:layout_marginTop="16dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/history_count" android:text="Giao dịch gần đây" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/ink" android:layout_marginTop="16dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/history_list" android:orientation="vertical" android:layout_marginTop="12dp"/>
  </LinearLayout>
</ScrollView>
